{
  "name": "sleveen-admin-web",
  "type": "module",
  "version": "2.0.2",
  "description": "Sleveen Admin — Soybean + Element Plus, SleveenAdmin.Web.Api",
  "author": {
    "name": "",
    "email": "",
    "url": ""
