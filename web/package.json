  "license": "MIT",
  "keywords": [
    "Vue3 admin ",
    "vue-admin-template",
    "Vite7",
    "TypeScript",
    "element-plus",
    "UnoCSS",
    "sleveen"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
