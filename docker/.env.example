# Docker 环境变量示例

# Redis（可选，用于监控与键值管理）
REDIS_PORT=6379

# 默认使用容器内 SQLite（见 docker-compose.yml 的 App_Data volume）
# 如需改用本机 SQL Server，可覆盖：
# DBCoonfig__Connections__0__DbType=MSSQL
# DBCoonfig__Connections__0__ConnectString=Enlist=false;Data Source=host.docker.internal;Database=sleveenadmin;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=True;
# Hangfire__Enabled=true
