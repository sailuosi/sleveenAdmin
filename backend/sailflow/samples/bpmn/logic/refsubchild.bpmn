<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:sf="http://www.sailflow.com/schema/sf"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_refsubchild" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- 被引用的外部子流程定义（供 refsubparent 通过 sf:subInfoes 绑定） -->
  <bpmn:process id="sail-seed-ref-child" name="引用子流程-子件" isExecutable="true"
    sf:code="SEED_REF_CHILD" sf:version="1">
    <bpmn:startEvent id="Start_1" sf:code="Start" name="开始">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ChildReview" sf:code="child_review" name="子件审核">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:extensionElements>
        <sf:assigneeResolve type="ApproverPick" params="" />
        <sf:leaveJudge type="Collaborate" params="{&quot;completeRate&quot;:1}" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ChildConfirm" sf:code="child_confirm" name="子件确认">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:extensionElements>
        <sf:assigneeResolve type="ApproverPick" params="" />
        <sf:leaveJudge type="Collaborate" params="{&quot;completeRate&quot;:1}" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" sf:code="End" name="结束">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_ChildReview" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_ChildReview" targetRef="Task_ChildConfirm" />
    <bpmn:sequenceFlow id="f3" sourceRef="Task_ChildConfirm" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sail-seed-ref-child">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChildReview_di" bpmnElement="Task_ChildReview">
        <dc:Bounds x="280" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChildConfirm_di" bpmnElement="Task_ChildConfirm">
        <dc:Bounds x="440" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="600" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="178" /><di:waypoint x="280" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="380" y="178" /><di:waypoint x="440" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="540" y="178" /><di:waypoint x="600" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
